# Root .env -- read by docker compose for interpolation.
# Copy to .env and fill in:  cp .env.example .env
#
# For a native (non-Docker) run the backend reads backend/.env instead; keep the
# database values in the two files consistent if you use both.

# --- PostgreSQL (the db service is created with these) ---
DB_USER=raguser
DB_PASSWORD=change-me
DB_NAME=ragdb

# --- JWT ---
# Required, no default: a shared default signing key would let anyone mint
# valid tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
